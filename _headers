# Cloudflare Pages headers for diamondback.run

# Serve the installer/upgrade scripts as plain text so `curl | bash` and browser
# viewing both get clean bytes (not a download or octet-stream).
/install.sh
  Content-Type: text/plain; charset=utf-8
/upgrade.sh
  Content-Type: text/plain; charset=utf-8

# The version feed drives the in-app update check and upgrade.sh — never cache it,
# so a new release is picked up immediately.
/version.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store

# The CloudFormation template is fetched by install.sh; serve it as plain text so a
# browser shows it rather than downloading it — a customer should be able to read the
# whole stack before running anything.
/diamondback-aws.yaml
  Content-Type: text/plain; charset=utf-8
